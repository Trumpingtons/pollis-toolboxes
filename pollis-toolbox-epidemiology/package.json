{
  "name": "pollis-toolbox-epidemiology",
  "displayName": "Epidemiology Toolbox",
  "description": "Pollis Epidemiology Toolbox: inference of epidemiological parameters, inference on contact networks, compartmental models (SIR, SIS, SEIR, SIRS, SEIRD), branching processes, epidemics on networks and coinfection.",
  "version": "0.1.6",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saragga/pollis"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "epidemiology",
        "title": "Epidemiology",
        "documents": [
          {
            "title": "Epidemiology Toolbox",
            "source": "docs/epidemiology/epidemiology.tex"
          }
        ],
        "panels": [
          {
            "id": "cest",
            "command": "chiara.statistics.cest",
            "title": "Contagion Models",
            "menuTitle": "Epidemiological Inference",
            "group": "1_inference",
            "order": 1,
            "data": "panels/cest.toml",
            "defaultModel": "rt",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "epiContacts",
            "command": "chiara.simulate.epi-contacts",
            "title": "Inference on Contact Networks",
            "group": "1_inference",
            "order": 2,
            "data": "panels/epiContacts.toml",
            "defaultModel": "risk",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "epiComp",
            "command": "chiara.simulate.epi-comp",
            "title": "Compartmental Models",
            "group": "2_models",
            "order": 3,
            "data": "panels/epiComp.toml",
            "defaultModel": "sir",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "epiBranch",
            "command": "chiara.simulate.epi-branch",
            "title": "Branching Processes",
            "group": "2_models",
            "order": 4,
            "data": "panels/epiBranch.toml",
            "defaultModel": "contain",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "epiNetwork",
            "command": "chiara.simulate.epi-network",
            "title": "Epidemics on Networks",
            "group": "2_models",
            "order": 5,
            "data": "panels/epiNetwork.toml",
            "defaultModel": "sir",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "epiCoinfection",
            "command": "chiara.simulate.epi-coinfection",
            "title": "Coinfection",
            "group": "2_models",
            "order": 6,
            "data": "panels/epiCoinfection.toml",
            "defaultModel": "two",
            "decisionFirstColumn": "Model"
          }
        ]
      }
    ]
  }
}
