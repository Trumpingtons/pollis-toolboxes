{
  "name": "pollis-toolbox-smart-regions",
  "displayName": "Smart Regions Toolbox",
  "description": "Pollis Smart Regions Toolbox: spatiotemporal infrastructure, pollution and climate, for municipalities and regional authorities in Smart Cities and Smart Rural Areas. Reads GeoJSON, GeoPackage, Shapefile, GeoParquet, FlatGeobuf, KML and GPX files through DuckDB's spatial extension, shows them on OpenStreetMap base maps, tests a value of a set of areas for spatial autocorrelation with Moran's I and Local Moran (LISA), and maps a value measured at stations with variograms, kriging, inverse distance weighting and Gaussian simulation.",
  "version": "0.1.5",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saragga/pollis"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": ["Other"],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "smart-regions",
        "title": "Smart Regions",
        "order": 1,
        "duckdbExtensions": ["spatial"],
        "submenus": [
          { "id": "accessFiles", "title": "Access Files", "group": "0_sr", "order": 1 },
          { "id": "accessDataLibraries", "title": "Access Data Libraries", "group": "0_sr", "order": 2 },
          { "id": "mapVisualisation", "title": "Map Visualisation", "group": "1_sr", "order": 0 },
          { "id": "spatialStatistics", "title": "Spatial Statistics and Kriging", "group": "2_sr", "order": 1 },
          { "id": "remoteSensing", "title": "Remote Sensing", "group": "3_sr", "order": 1 },
          { "id": "pointClouds", "title": "Point Cloud Processing", "group": "3_sr", "order": 2 },
          { "id": "smartCities", "title": "Smart Cities", "group": "4_sr", "order": 1 },
          { "id": "smartRuralAreas", "title": "Smart Rural Areas", "group": "4_sr", "order": 2 }
        ],
        "panels": [
          {
            "id": "geofiles", "command": "pollis.smartRegions.geofiles", "title": "Geospatial Vector Files", "menuTitle": "GeoJSON Files", "submenu": "accessFiles", "group": "1_files", "order": 1, "data": "panels/geofiles.toml", "defaultModel": "geojson", "decisionFirstColumn": "Format",
            "tabs": [
              { "model": "gpkg", "command": "pollis.smartRegions.geofiles.gpkg", "title": "GeoPackage Files" },
              { "model": "shapefile", "command": "pollis.smartRegions.geofiles.shapefile", "title": "Shapefiles" },
              { "model": "geoparquet", "command": "pollis.smartRegions.geofiles.geoparquet", "title": "GeoParquet and FlatGeobuf Files" },
              { "model": "kml", "command": "pollis.smartRegions.geofiles.kml", "title": "KML and KMZ Files" },
              { "model": "gpx", "command": "pollis.smartRegions.geofiles.gpx", "title": "GPX Files" }
            ]
          },
          {
            "id": "basemaps", "command": "pollis.smartRegions.basemaps", "title": "OpenStreetMap Base Maps", "menuTitle": "Base Map", "submenu": "mapVisualisation", "group": "1_basemaps", "order": 1, "data": "panels/basemaps.toml", "defaultModel": "place", "decisionFirstColumn": "Map"
          },
          {
            "id": "autocorr", "command": "pollis.smartRegions.autocorr", "title": "Spatial Autocorrelation", "menuTitle": "Global Moran's I", "submenu": "spatialStatistics", "group": "1_autocorrelation", "order": 1, "data": "panels/autocorr.toml", "defaultModel": "global", "decisionFirstColumn": "Statistic",
            "tabs": [
              { "model": "local", "command": "pollis.smartRegions.autocorr.local", "title": "Local Moran (LISA)" }
            ]
          },
          {
            "id": "kriging", "command": "pollis.smartRegions.kriging", "title": "Kriging", "submenu": "spatialStatistics", "group": "2_kriging", "order": 1, "data": "panels/kriging.toml", "defaultModel": "variogram", "decisionFirstColumn": "Method"
          }
        ],
