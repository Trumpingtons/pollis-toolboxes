{
  "name": "pollis-toolbox-spatial-econometrics",
  "displayName": "Spatial Econometrics Toolbox",
  "description": "Pollis Spatial Econometrics Toolbox: regression models for data on regions, municipalities and other areas, where each area's outcome depends on its neighbours. Spatial lag and error models, geographically weighted regression, eigenvector spatial filtering, spatial discrete choice, spatial panel data, spatio-temporal forecasting, spatial causal inference, and regionalisation with spatial regimes.",
  "version": "0.1.7",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saragga/pollis"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": ["Other"],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "spatial-econometrics",
        "title": "Spatial Econometrics",
        "order": 1,
        "duckdbExtensions": ["spatial"],
        "documents": [
          {
            "title": "Spatial Econometrics Toolbox",
            "source": "docs/spatial-econometrics/spatial-econometrics.tex"
          }
        ],
        "panels": [
          {
            "id": "spatialreg",
            "command": "pollis.spatialEconometrics.spatialreg",
            "title": "Spatial Lag and Error Models",
            "group": "1_crossSection",
            "order": 1,
            "data": "panels/spatialreg.toml",
            "defaultModel": "ols",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "gwr",
            "command": "pollis.spatialEconometrics.gwr",
            "title": "Geographically Weighted Regression",
            "group": "1_crossSection",
            "order": 2,
            "data": "panels/gwr.toml",
            "defaultModel": "gwrfixed",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "esf",
            "command": "pollis.spatialEconometrics.esf",
            "title": "Eigenvector Spatial Filtering",
            "group": "1_crossSection",
            "order": 3,
            "data": "panels/esf.toml",
            "defaultModel": "esfmoran",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "spchoice",
            "command": "pollis.spatialEconometrics.spchoice",
            "title": "Spatial Discrete Choice",
            "group": "1_crossSection",
            "order": 4,
            "data": "panels/spchoice.toml",
            "defaultModel": "probitgmm",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "sppanel",
            "command": "pollis.spatialEconometrics.sppanel",
            "title": "Spatial Panel Data",
            "group": "2_spaceTime",
            "order": 1,
            "data": "panels/sppanel.toml",
            "defaultModel": "sarfe",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "stforecast",
            "command": "pollis.spatialEconometrics.stforecast",
            "title": "Spatio-Temporal Forecasting",
            "group": "2_spaceTime",
            "order": 2,
            "data": "panels/stforecast.toml",
            "defaultModel": "star",
            "decisionFirstColumn": "Model"
          },
          {
            "id": "spcausal",
            "command": "pollis.spatialEconometrics.spcausal",
            "title": "Spatial Causal Inference",
            "group": "3_regions",
            "order": 1,
            "data": "panels/spcausal.toml",
            "defaultModel": "spdid",
            "decisionFirstColumn": "Model"
          }
        ],
        "planned": [
          { "title": "Regionalisation and Spatial Regimes", "group": "3_regions", "order": 2 }
        ]
      }
    ]
  }
}
