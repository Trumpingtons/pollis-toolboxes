{
  "name": "pollis-toolbox-geoprocessing",
  "displayName": "Geoprocessing Toolbox",
  "description": "Pollis Geoprocessing Toolbox: calculations on rasters and elevation models in Julia. Computes local, focal and zonal operations on rasters, resamples them and puts polygons onto a grid with Rasters.jl and Stencils.jl, and computes the slope, aspect, hillshade, curvature, relief indices, upslope area and Topographic Wetness and Stream Power indices of an elevation model with Geomorphometry.jl and Stencils.jl, each replicated with R's terra, MultiscaleDTM or WhiteboxTools.",
  "version": "0.1.9",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saragga/pollis"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": ["Other"],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "geoprocessing",
        "title": "Geoprocessing",
        "order": 1,
        "duckdbExtensions": ["spatial"],
        "submenus": [
          { "id": "satelliteIndicators", "title": "Satellite Indicators", "group": "2_imagery", "order": 1 },
          { "id": "lidar", "title": "Lidar and 3D Scans", "group": "2_imagery", "order": 2 }
        ],
        "panels": [
          {
            "id": "gridcalc", "command": "pollis.geoprocessing.gridcalc", "title": "Grid Calculations", "group": "1_rasters", "order": 1, "data": "panels/gridcalc.toml", "defaultModel": "local", "decisionFirstColumn": "Operation"
          },
          {
            "id": "terrain", "command": "pollis.geoprocessing.terrain", "title": "Terrain and Elevation Analysis", "group": "1_rasters", "order": 2, "data": "panels/terrain.toml", "defaultModel": "slope", "decisionFirstColumn": "Measure"
          }
        ],
        "planned": [
          { "title": "Vegetation Indices (NDVI)", "submenu": "satelliteIndicators", "group": "1_satelliteIndicators", "order": 1 },
          { "title": "Land Cover Classification", "submenu": "satelliteIndicators", "group": "1_satelliteIndicators", "order": 2 },
          { "title": "Land Surface Temperature", "submenu": "satelliteIndicators", "group": "1_satelliteIndicators", "order": 3 },
          { "title": "Burned Area and Flood Mapping", "submenu": "satelliteIndicators", "group": "1_satelliteIndicators", "order": 4 },
          { "title": "Ground Movement from Radar (InSAR)", "submenu": "satelliteIndicators", "group": "1_satelliteIndicators", "order": 5 },
          { "title": "Night-Time Lights", "submenu": "satelliteIndicators", "group": "1_satelliteIndicators", "order": 6 },
          { "title": "Filtering and Ground Classification", "submenu": "lidar", "group": "1_lidar", "order": 1 },
          { "title": "Building Extraction and 3D City Models", "submenu": "lidar", "group": "1_lidar", "order": 2 },
          { "title": "Tree and Canopy Metrics", "submenu": "lidar", "group": "1_lidar", "order": 3 },
          { "title": "Change Between Surveys", "submenu": "lidar", "group": "1_lidar", "order": 4 },
          { "title": "Coordinate Transformations and Projections", "group": "3_coordinates", "order": 1 },
          { "title": "Spatial Indexing", "group": "3_coordinates", "order": 2 }
        ]
      }
    ]
  }
}
