{
  "name": "pollis-toolbox-learning-and-practice",
  "displayName": "Self-Study: Learn and Practise",
  "description": "Turn your slides, notes and PDFs into what helps you study: more problems with their solutions, a topic explained in depth, a summary of a paper, prose and audio from slides, or slides from a long text. For students, and for teachers preparing their classes.",
  "version": "0.1.3",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "learning",
        "title": "Self-Study: Learn and Practise",
        "documents": [
          {
            "title": "Self-Study Guide",
            "source": "docs/guide/guide.tex"
          },
          {
            "title": "Self-Study: Learn and Practise",
            "source": "docs/self-study/self-study.tex"
          }
        ],
        "panels": [
          {
            "id": "learning-and-practice.practice",
            "command": "pollis.pollis-toolbox-learning-and-practice.practice",
            "title": "Practice",
            "group": "1_panels",
            "order": 1,
            "data": "panels/learning-and-practice.practice.toml",
            "defaultModel": "ds",
            "decisionFirstColumn": "Topic"
          },
          {
            "id": "learning-and-practice.exwrite",
            "command": "pollis.pollis-toolbox-learning-and-practice.exwrite",
            "title": "Write an Exercise",
            "group": "1_panels",
            "order": 2,
            "data": "panels/learning-and-practice.exwrite.toml",
            "defaultModel": "computed",
            "decisionFirstColumn": "Kind"
          }
        ]
      }
    ]
  }
}
