{
  "name": "pollis-toolbox-historical-geography-and-archaeology",
  "displayName": "Historical Geography and Archaeology Toolbox",
  "description": "Pollis Historical Geography and Archaeology Toolbox: the past on the map, for historians, archaeologists, heritage officers, museums, and the municipalities and regions with history attached. Maps the borders of states with a year slider, from Cliopatria, the world maps of historical-basemaps and CShapes 2.0, and tells which states held a place over the centuries. Sets old maps beside today's map, with a line to swipe between them: the maps of Cassini and of the état-major and IGN's aerial photographs since 1950 for France, the maps that libraries have shared and Allmaps has georeferenced anywhere, and eight famous maps from the Tabula Peutingeriana to the Tasman map. Maps the populations of the past, from the European cities of Buringh, the world cities of Chandler and Modelski, and the grid of HYDE 3.5. For archaeological prospection, shows lidar terrain models as relief images, finds the places shaped like earthworks, and applies the trained models of ADAF to them.",
  "version": "0.1.13",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saragga/pollis"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": ["Other"],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "historical-geography-and-archaeology",
        "title": "Historical Geography and Archaeology",
        "order": 1,
        "duckdbExtensions": ["spatial", "excel"],
        "submenus": [
          { "id": "archaeology", "title": "Archaeological Prospection", "group": "3_archaeology", "order": 1 }
        ],
        "panels": [
          {
            "id": "histborders", "command": "pollis.historicalGeography.histborders", "title": "Historical Borders", "group": "1_history", "order": 1, "data": "panels/histborders.toml", "defaultModel": "cliopatria", "decisionFirstColumn": "Source"
          },
          {
            "id": "oldmaps", "command": "pollis.historicalGeography.oldmaps", "title": "Historical Maps", "group": "1_history", "order": 2, "data": "panels/oldmaps.toml", "defaultModel": "france", "decisionFirstColumn": "Tab"
          },
          {
            "id": "histpop", "command": "pollis.historicalGeography.histpop", "title": "Historical Populations", "group": "1_history", "order": 3, "data": "panels/histpop.toml", "defaultModel": "buringh", "decisionFirstColumn": "Source"
          },
          {
            "id": "reliefvis", "command": "pollis.historicalGeography.reliefvis", "title": "Relief Visualisation", "submenu": "archaeology", "group": "1_archaeology", "order": 1, "data": "panels/reliefvis.toml", "defaultModel": "lrm", "decisionFirstColumn": "Visualisation"
          },
          {
            "id": "candidates", "command": "pollis.historicalGeography.candidates", "title": "Candidate Features", "submenu": "archaeology", "group": "1_archaeology", "order": 2, "data": "panels/candidates.toml", "defaultModel": "mounds", "decisionFirstColumn": "Method"
          },
          {
            "id": "learnedlidar", "command": "pollis.historicalGeography.learnedlidar", "title": "Learned Detection in Lidar", "submenu": "archaeology", "group": "1_archaeology", "order": 3, "data": "panels/learnedlidar.toml"
          },
          {
            "id": "learnedsatellite", "command": "pollis.historicalGeography.learnedsatellite", "title": "Learned Detection in Satellite Images", "submenu": "archaeology", "group": "1_archaeology", "order": 4, "data": "panels/learnedsatellite.toml"
          },
          {
            "id": "enkiheldout", "command": "pollis.historicalGeography.enkiheldout", "title": "Enki on Held-Out Ground", "submenu": "archaeology", "group": "1_archaeology", "order": 5, "data": "panels/enkiheldout.toml", "defaultModel": "published", "decisionFirstColumn": "Tab"
          },
          {
            "id": "sitesmonuments", "command": "pollis.historicalGeography.sitesmonuments", "title": "Sites and Monuments", "group": "3_archaeology", "order": 2, "data": "panels/sitesmonuments.toml", "defaultModel": "pleiades", "decisionFirstColumn": "Register"
          },
          {
            "id": "atwar", "command": "pollis.historicalGeography.atwar", "title": "At War", "group": "2_topics", "order": 1, "data": "panels/atwar.toml"
          },
          {
            "id": "conquests", "command": "pollis.historicalGeography.conquests", "title": "Conquests", "group": "2_topics", "order": 2, "data": "panels/conquests.toml"
          },
          {
            "id": "places", "command": "pollis.historicalGeography.places", "title": "Places", "group": "2_topics", "order": 3, "data": "panels/places.toml"
          },
          {
            "id": "journeys", "command": "pollis.historicalGeography.journeys", "title": "Journeys", "group": "2_topics", "order": 4, "data": "panels/journeys.toml"
          }
        ],
        "pages": [
          { "command": "pollis.britannica.open", "title": "Britannica Through the Editions", "group": "1_history", "order": 4 }
        ]
      }
    ]
  }
}
