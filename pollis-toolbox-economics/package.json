{
  "name": "pollis-toolbox-economics",
  "displayName": "Economics Toolbox",
  "description": "Pollis Economics Toolbox: business cycle filters, discrete-time stochastic volatility models, DSGE models, VAR/VECM systems, heterogeneous-agent models, continuous-time macro-finance and game theory.",
  "version": "0.1.10",
  "publisher": "pollis",
  "author": "Pollis",
  "license": "AGPL-3.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saragga/pollis"
  },
  "engines": {
    "vscode": "*"
  },
  "categories": ["Other"],
  "contributes": {
    "pollisToolboxes": [
      {
        "id": "economics",
        "title": "Economics",
        "order": 1,
        "courses": [
          {
            "title": "QuantEcon Julia Lectures (Jupyter)",
            "url": "https://julia.quantecon.org"
          }
        ],
        "documents": [
          {
            "title": "Economics Toolbox",
            "source": "docs/economics/economics.tex"
          }
        ],
        "panels": [
          { "id": "bcf", "command": "chiara.statistics.macro.hpf", "title": "Business Cycle Filters", "group": "4_mt", "order": 1, "data": "panels/bcf.toml", "defaultModel": "hp", "decisionFirstColumn": "Model" },
          { "id": "dtsv", "command": "chiara.statistics.macro.dtsvm", "title": "Discrete-Time Stochastic Volatility Models", "group": "4_mt", "order": 2, "data": "panels/dtsv.toml", "defaultModel": "basic", "decisionFirstColumn": "Model" },
          { "id": "dsge", "command": "chiara.statistics.macro.dsge", "title": "DSGE Models", "menuTitle": "Dynamic Stochastic General Equilibrium (DSGE)", "group": "4_mt", "order": 3, "data": "panels/dsge.toml", "defaultModel": "mom", "decisionFirstColumn": "Mode" },
          { "id": "var", "command": "chiara.statistics.arma.varModels", "title": "VAR Models", "menuTitle": "VAR/VECM Systems", "group": "4_mt", "order": 4, "data": "panels/var.toml", "defaultModel": "var", "decisionFirstColumn": "Model" },
          { "id": "ham", "command": "chiara.statistics.macro.ham", "title": "Heterogeneous-Agent Models", "group": "4_mt", "order": 5, "data": "panels/ham.toml", "defaultModel": "main", "decisionFirstColumn": "Model" },
          { "id": "ctmf", "command": "chiara.statistics.macro.ctmf", "title": "Continuous-Time Macro-Finance", "group": "4_mt", "order": 6, "data": "panels/ctmf.toml", "defaultModel": "main", "decisionFirstColumn": "Model" },
          { "id": "gt", "command": "chiara.statistics.macro.gt", "title": "Game Theory", "group": "5_gt", "order": 1, "data": "panels/gt.toml", "defaultModel": "normal", "decisionFirstColumn": "Game" }
        ]
      }
    ]
  }
}
